tab = [41, 55, 21, 18, 12, 6, 25]
def echange(tab, i, j):
    '''Echange les éléments d'indice i et j dans le tableau tab.'''
    #print(i,j)
    temp = tab[i]
    tab[i] = tab[j]
    tab[j] = temp
def tri_selection(tab):
    '''Trie le tableau tab dans l'ordre croissant
    par la méthode du tri par sélection.'''
    N = len(tab)
    #print(N)
    for k in range(N):
        imin = k
        for i in range(k+1, N):
            #print(i)
            if tab[i] < tab[imin]:
                imin = i
        echange(tab, k, imin)
    #print(tab)

